# ── PayPal ──────────────────────────────────────────────
# Obtén estas credenciales en: https://developer.paypal.com/
# Dashboard → Apps & Credentials → Tu App → Client ID / Secret

PAYPAL_CLIENT_ID=TU_CLIENT_ID_AQUI
PAYPAL_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI

# "sandbox" para pruebas, "live" para producción
PAYPAL_MODE=sandbox

# ── Resend (servicio de email) ───────────────────────────
# Crea cuenta gratis en: https://resend.com
# Dashboard → API Keys → Create API Key

RESEND_API_KEY=re_TU_API_KEY_AQUI

# Dirección FROM del email (debe ser un dominio verificado en Resend)
# Para pruebas puedes usar: onboarding@resend.dev
FROM_EMAIL=VAL_Config Pro <noreply@tudominio.com>
